xnu 0113: keep the sampler out of the console and UFS paths

The 0112 runs freeze about 30 s after the daemons start: the last console line
is arbitrary, the sampler stops and the panel keeps the last line until the
phone is reset. The sampler is the only new code that printf()s from inside
the console path (the log thread) and from inside the UFS strategy path
(neo5se_log_kick), and its printf() goes straight back through both, so a
re-entry there wedges the machine with the console lock held.

Tick at most once a second and never from inside a tick, and drop the call
from the UFS strategy path; the log thread and the sampler thread still drive
it. Print the per-thread dump after dropping the task lock, because the
printf() sleeps on the console and on the UFS-backed ring. The sample line
now carries the uptime in seconds, so a boot that stops early can be measured
instead of guessed.

--- a/bsd/dev/neo5se_sample.c
+++ b/bsd/dev/neo5se_sample.c
@@ -18,6 +18,7 @@
 #include <sys/systm.h>
 #include <sys/proc.h>
 #include <sys/proc_internal.h>
+#include <kern/clock.h>
 #include <kern/task.h>
 #include <kern/thread.h>
 #include <pexpert/pexpert.h>
@@ -157,10 +158,23 @@
  * the tsleep() timeout stops firing after userland starts, and from the
  * sampler thread as a slow fallback.
  */
+static uint64_t neo5se_last_tick;
+static int      neo5se_in_tick;
+
+static uint64_t
+neo5se_uptime_ns(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
 void
 neo5se_sample_tick(void)
 {
 	static bool armed, dumped;
+	uint64_t now;
 
 	if (!armed) {
 		armed = true;
@@ -168,8 +182,22 @@
 		printf("NEO5SE SMP: samples armed (%d names)\n", neo5se_names_count);
 	}
 	if (neo5se_names_count == 0 || neo5se_names[0][0] == '-') {
+		return;
+	}
+	/*
+	 * The tick is also called from the console and UFS paths, and printf
+	 * runs back through both. Re-entering here, or printing on every write,
+	 * wedged the boot: run at most once a second and never from a tick.
+	 */
+	if (neo5se_in_tick) {
 		return;
 	}
+	now = neo5se_uptime_ns();
+	if (now - neo5se_last_tick < 1000000000ULL) {
+		return;
+	}
+	neo5se_last_tick = now;
+	neo5se_in_tick = 1;
 	neo5se_proc_len = 0;
 	neo5se_proc_count = 0;
 	neo5se_proc_list[0] = 0;
@@ -179,7 +207,8 @@
 	}
 	proc_iterate(PROC_ALLPROCLIST, neo5se_sample_list, NULL, NULL, NULL);
 
-	printf("SMP %d procs", neo5se_proc_count);
+	printf("SMP t=%llus %d procs", (unsigned long long)(now / 1000000000ULL),
+	    neo5se_proc_count);
 	for (int k = 0; k < neo5se_names_count; k++) {
 		printf(" | %s(%d) pc=0x%llx", neo5se_names[k],
 		    neo5se_want_pid[k], neo5se_want_pc[k]);
@@ -231,6 +260,7 @@
 		printf("SMP --- detailed sample, %d procs\n", neo5se_proc_count);
 		proc_iterate(PROC_ALLPROCLIST, neo5se_sample_proc, NULL, NULL, NULL);
 	}
+	neo5se_in_tick = 0;
 }
 
 static void
--- a/bsd/dev/neo5se_ufs.c
+++ b/bsd/dev/neo5se_ufs.c
@@ -1253,20 +1253,15 @@
 neo5se_log_kick(void)
 {
 	uint64_t total = os_atomic_load(&neo5se_log_total, relaxed);
-
-	static uint32_t calls;
 
 	if (total - os_atomic_load(&neo5se_log_flushed, relaxed) >= NEO5SE_LOG_KICK_BYTES) {
 		neo5se_log_store(total);
 	}
 	/*
-	 * The sampler has the same dead timeout, so give it this clock too:
-	 * one line every 256 write-path calls.
+	 * No sampler tick here: this runs inside the UFS strategy path, and the
+	 * sampler's printf goes back out through the console and this same
+	 * driver. The log thread draws the samples from console traffic instead.
 	 */
-	if ((++calls & 0xff) == 0) {
-		extern void neo5se_sample_tick(void);
-		neo5se_sample_tick();
-	}
 }
 
