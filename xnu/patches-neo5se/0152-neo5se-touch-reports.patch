+#include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <arm/caches_internal.h>
 #include <vm/pmap.h>
@@ -845,6 +848,131 @@
 	neo5se_tlmm_write(neo5se_spi_mosi, NEO5SE_TLMM_IN_OUT, 0);
 	neo5se_tlmm_write(neo5se_spi_cs, NEO5SE_TLMM_IN_OUT, 2);
 	return 0;
+}
+
+/* IOKit side of the port: MondrianHIDTouch::touch() through its C bridge. */
+extern void neo5se_hid_touch(int finger, int down, int x, int y);
+
+/* The report block, from the working system's IC info dump (ic_info_length
+ * 193): touch_data_addr 0x00010308, head 8 bytes, 8 bytes per point. */
+#define NEO5SE_TOUCH_DATA_ADDR	0x00010308u
+#define NEO5SE_TOUCH_POINT_LEN	8
+#define NEO5SE_TOUCH_FINGERS		10
+
+static uint32_t neo5se_touch_data_addr = NEO5SE_TOUCH_DATA_ADDR;
+
+/*
+ * The register block at 0x10070 is the packed goodix_ic_info. The driver's
+ * struct puts misc.touch_data_addr at 161, touch_data_head_len at 165 and
+ * point_struct_len at 167, and the part's blob is 193 bytes long, so all
+ * three fields are inside it. Read them back instead of trusting the constant:
+ * this firmware's block could carry a different address.
+ */
+static void
+neo5se_touch_ic_info(void)
+{
+	uint8_t info[200];
+	uint32_t addr, i;
+	uint16_t head, point;
+
+	for (i = 0; i < sizeof(info); i++) {
+		info[i] = 0;
+	}
+	(void)neo5se_goodix_read(0x00010070, info, sizeof(info));
+	addr = (uint32_t)info[161] | ((uint32_t)info[162] << 8) |
+	    ((uint32_t)info[163] << 16) | ((uint32_t)info[164] << 24);
+	head = (uint16_t)(info[165] | (info[166] << 8));
+	point = (uint16_t)(info[167] | (info[168] << 8));
+	printf("NEO5SE TOUCH: ic info len %u cfg 0x%x data 0x%x head %u point %u\n",
+	    (unsigned)(info[0] | (info[1] << 8)), info[10], addr, head, point);
+	if (addr != 0 && head >= 8 && head <= 32 && point == NEO5SE_TOUCH_POINT_LEN) {
+		neo5se_touch_data_addr = addr;
+	} else {
+		printf("NEO5SE TOUCH: ic info unusable, keeping 0x%x\n",
+		    neo5se_touch_data_addr);
+	}
+	neo5se_log_flush_now();
+}
+
+/*
+ * The part raises IRQ (GPIO21, active low) when a report is ready and drops it
+ * when the host writes one zero byte back to the report address. Poll the line
+ * instead of wiring GIC 305 for now: once per 10 ms tick is enough to prove the
+ * reports, and leaves the interrupt path for a later patch.
+ */
+static void __attribute__((noreturn))
+neo5se_touch_thread(void *arg, wait_result_t wait)
+{
+	uint8_t head[8], point_buf[2 + NEO5SE_TOUCH_FINGERS * NEO5SE_TOUCH_POINT_LEN];
+	uint8_t was[NEO5SE_TOUCH_FINGERS], now[NEO5SE_TOUCH_FINGERS];
+	int16_t last_x[NEO5SE_TOUCH_FINGERS], last_y[NEO5SE_TOUCH_FINGERS];
+	uint32_t reports = 0, i;
+	int finger, num, point;
+	uint8_t zero = 0;
+
+	(void)arg;
+	(void)wait;
+	for (i = 0; i < NEO5SE_TOUCH_FINGERS; i++) {
+		was[i] = 0;
+		now[i] = 0;
+		last_x[i] = 0;
+		last_y[i] = 0;
+	}
+	for (;;) {
+		(void)tsleep((caddr_t)&neo5se_touch_data_addr, PZERO - 1, "mtouch", 1);
+		if ((neo5se_tlmm_read(neo5se_touch_irq_page, NEO5SE_TLMM_IN_OUT) & 1) != 0) {
+			continue;
+		}
+		(void)neo5se_goodix_read(neo5se_touch_data_addr, head, sizeof(head));
+		num = head[2] & 0x0f;
+		if (num > NEO5SE_TOUCH_FINGERS) {
+			num = NEO5SE_TOUCH_FINGERS;
+		}
+		for (i = 0; i < NEO5SE_TOUCH_FINGERS; i++) {
+			now[i] = 0;
+		}
+		if (num > 0) {
+			for (i = 0; i < sizeof(point_buf); i++) {
+				point_buf[i] = 0;
+			}
+			(void)neo5se_goodix_read(neo5se_touch_data_addr + sizeof(head),
+			    point_buf, (uint32_t)(num * NEO5SE_TOUCH_POINT_LEN + 2));
+			for (point = 0; point < num; point++) {
+				uint8_t *p = &point_buf[point * NEO5SE_TOUCH_POINT_LEN];
+				int id = (p[0] >> 4) & 0x0f;
+				int x = p[2] | (p[3] << 8);
+				int y = p[4] | (p[5] << 8);
+
+				if (id >= NEO5SE_TOUCH_FINGERS) {
+					continue;
+				}
+				now[id] = 1;
+				last_x[id] = (int16_t)x;
+				last_y[id] = (int16_t)y;
+				neo5se_hid_touch(id, 1, x, y);
+				if (reports < 30) {
+					printf("NEO5SE TOUCH: report %u finger %d %d,%d\n",
+					    reports, id, x, y);
+				}
+			}
+		}
+		for (finger = 0; finger < NEO5SE_TOUCH_FINGERS; finger++) {
+			if (was[finger] && !now[finger]) {
+				neo5se_hid_touch(finger, 0, last_x[finger], last_y[finger]);
+				if (reports < 30) {
+					printf("NEO5SE TOUCH: report %u finger %d up\n",
+					    reports, finger);
+				}
+			}
+			was[finger] = now[finger];
+		}
+		/* One zero byte at the report address clears it and releases IRQ. */
+		(void)neo5se_goodix_write(neo5se_touch_data_addr, &zero, 1);
+		if (reports < 30) {
+			neo5se_log_flush_now();
+		}
+		reports++;
+	}
 }
 
