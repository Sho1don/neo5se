+			base = neo5se_gpu_read(neo5se_uc_gpu,
 			    GEN7_CP_IB1_BASE * 4u);
-			uint32_t rem = neo5se_gpu_read(neo5se_uc_gpu,
+			rem = neo5se_gpu_read(neo5se_uc_gpu,
 			    GEN7_CP_IB1_REM_SIZE * 4u);
-
 			printf("NEO5SE GPU: uc sqe pc 0x%x packet 0x%08x ib1 0x%x rem 0x%x ib2 0x%x rem2 0x%x\n",
 			    pc, packet, base, rem,
 			    neo5se_gpu_read(neo5se_uc_gpu,
@@ -3092,16 +3107,16 @@
 			    GEN7_CP_IB2_REM_SIZE * 4u));
 			printf("NEO5SE GPU: uc ib1 stopped at %u dwords\n",
