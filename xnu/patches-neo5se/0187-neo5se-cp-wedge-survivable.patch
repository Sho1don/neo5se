-		{
-			uint32_t pc = neo5se_gpu_read(neo5se_uc_gpu,
+		/*
+		 * This line has to be able to print whatever happened: it is
+		 * built from the fence word in memory and needs no GPU
+		 * register. A CP that has wedged stalls its own register
+		 * access and the CPU read never returns, which is what used to
+		 * kill the whole boot (and, with it, the reset thread that
+		 * returns the phone to fastboot). The register reads below are
+		 * therefore opt-in with gpudump=1.
+		 */
+		printf("NEO5SE GPU: uc big %u dwords fence %u done %u in %u ms\n",
+		    dwords, seq, (int32_t)(value - seq) >= 0, waited);
+		neo5se_log_flush_now();
