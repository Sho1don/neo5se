-		    neo5se_gpu_read(neo5se_uc_gpu,
-		    GEN7_CP_INTERRUPT_STATUS * 4u),
-		    neo5se_gpu_read(neo5se_uc_gpu, GEN7_CP_HW_FAULT * 4u),
-		    neo5se_gpu_read(neo5se_uc_gpu,
-		    GEN7_CP_PROTECT_STATUS * 4u),
