xnu 0161: tick the touch report thread from the vsync

The part reports at about 100 Hz, but the report thread waits in
tsleep(..., 1 tick) and tsleep() deadlines do not fire on this board
(the sampler had the same problem and is ticked from the framebuffer
timer). Measured: 55 touch events in 110 s of interaction, so the UI
saw 0.5 positions a second and felt frozen. Wake the thread from the
framebuffer vsync instead (60 Hz, the panel rate) and print the reports
read per second in the fps line. The copy and the rasterizer were not
the cause: copy 2.3 ms, raster 10-14 ms.
--- a/bsd/dev/neo5se_touch.c
+++ b/bsd/dev/neo5se_touch.c
@@ -884,11 +883,34 @@
 /* The report block, from the working system's IC info dump (ic_info_length
  * 193): touch_data_addr 0x00010308, head 8 bytes, 8 bytes per point. */
 #define NEO5SE_TOUCH_DATA_ADDR	0x00010308u
+/* Reports read since boot, for the fps line; and the vsync kick below. */
+static uint32_t neo5se_touch_reports_read;
+static uint32_t neo5se_touch_polls;
+
+uint32_t
+neo5se_touch_report_count(void)
+{
+	return neo5se_touch_reports_read;
+}
+
 #define NEO5SE_TOUCH_POINT_LEN	8
 #define NEO5SE_TOUCH_FINGERS		10
 
 static uint32_t neo5se_touch_data_addr = NEO5SE_TOUCH_DATA_ADDR;
 static uint32_t neo5se_touch_cmd_addr;
+/*
+ * The report thread cannot wait on its own timeout: tsleep() deadlines do not
+ * fire on this board (the sampler has the same problem and is ticked from the
+ * framebuffer). Wake it from the vsync timer instead, so the part is read at
+ * the panel rate and not at whatever rate the broken timer allows.
+ */
+void
+neo5se_touch_vsync(void)
+{
+	if (neo5se_touch_data_addr != 0) {
+		wakeup((caddr_t)&neo5se_touch_data_addr);
+	}
+}
 static uint16_t neo5se_touch_cmd_len;
 static int neo5se_touch_poll;
 
@@ -1337,11 +1359,13 @@
 	}
 	for (;;) {
 		(void)tsleep((caddr_t)&neo5se_touch_data_addr, PZERO - 1, "mtouch", 1);
+		neo5se_touch_polls++;
 		if (!neo5se_touch_poll &&
 		    (neo5se_tlmm_read(neo5se_touch_irq_page, NEO5SE_TLMM_IN_OUT) & 1) != 0) {
 			continue;
 		}
 		(void)neo5se_goodix_read(neo5se_touch_data_addr, head, sizeof(head));
+		neo5se_touch_reports_read++;
 		num = head[2] & 0x0f;
 		if (num > NEO5SE_TOUCH_FINGERS) {
 			num = NEO5SE_TOUCH_FINGERS;
