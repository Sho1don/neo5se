xnu 0142: drive the SPI pads before power-on, and try 2.5 MHz

Android's QUP owns the four SPI pads before the part leaves reset (clock low,
CS high). This driver configured them only after power-on, so the part came
out of reset with its bus floating, and a slave that samples its interface at
reset release can latch the wrong mode. Map and drive the pads first.

The confirm also runs at 2.5 MHz after three tries at 600 kHz: the working
driver talks to the part at up to 15 MHz, and a slave with a transfer timeout
would ignore a clock that is 25 times slower.

--- a/bsd/dev/neo5se_touch.c
+++ b/bsd/dev/neo5se_touch.c
@@ -614,6 +614,8 @@
 static vm_offset_t neo5se_spi_clk, neo5se_spi_mosi, neo5se_spi_miso,
     neo5se_spi_cs;
 static uint64_t neo5se_spi_hz;
+/* Half a bit period in nanoseconds; the part runs at 15 MHz in Android. */
+static uint32_t neo5se_spi_half = 800;
 
 static void
 neo5se_spi_delay(uint32_t ns)
@@ -630,12 +632,12 @@
 neo5se_spi_bit(int mosi)
 {
 	neo5se_tlmm_write(neo5se_spi_mosi, NEO5SE_TLMM_IN_OUT, mosi ? 2 : 0);
-	neo5se_spi_delay(800);
+	neo5se_spi_delay(neo5se_spi_half);
 	neo5se_tlmm_write(neo5se_spi_clk, NEO5SE_TLMM_IN_OUT, 2);
-	neo5se_spi_delay(800);
+	neo5se_spi_delay(neo5se_spi_half);
 	int miso = (int)(neo5se_tlmm_read(neo5se_spi_miso, NEO5SE_TLMM_IN_OUT) & 1);
 	neo5se_tlmm_write(neo5se_spi_clk, NEO5SE_TLMM_IN_OUT, 0);
-	neo5se_spi_delay(800);
+	neo5se_spi_delay(neo5se_spi_half);
 	return miso;
 }
 
@@ -778,18 +780,13 @@
 static void
 neo5se_touch_spi_probe(void)
 {
-	if (neo5se_spi_pins() != 0) {
-		printf("NEO5SE TOUCH: spi: cannot map the pads\n");
-		neo5se_log_flush_now();
-		return;
-	}
 	printf("NEO5SE TOUCH: spi: bit-bang on gpio16-19, ~600 kHz, goodix framing\n");
 	neo5se_log_flush_now();
 
 	{
 		uint8_t tx[8], rx[8];
 		uint32_t j;
-		int same = 1;
+		int same = 1, tries;
 
 		/*
 		 * brl_dev_confirm: eight 0xAA bytes at 0x10000, read back and
@@ -798,18 +795,30 @@
 		for (j = 0; j < sizeof(tx); j++) {
 			tx[j] = 0xaa;
 		}
-		(void)neo5se_goodix_write(0x10000, tx, sizeof(tx));
-		delay(1000);
-		(void)neo5se_goodix_read(0x10000, rx, sizeof(rx));
-		for (j = 0; j < sizeof(rx); j++) {
-			if (rx[j] != tx[j]) {
-				same = 0;
+		for (tries = 0; tries < 6; tries++) {
+			/* Three tries at 600 kHz, then three at 2.5 MHz. */
+			neo5se_spi_half = (tries < 3) ? 800 : 200;
+			for (j = 0; j < sizeof(tx); j++) {
+				rx[j] = 0;
 			}
+			(void)neo5se_goodix_write(0x10000, tx, sizeof(tx));
+			delay(1000);
+			(void)neo5se_goodix_read(0x10000, rx, sizeof(rx));
+			same = 1;
+			for (j = 0; j < sizeof(rx); j++) {
+				if (rx[j] != tx[j]) {
+					same = 0;
+				}
+			}
+			printf("NEO5SE TOUCH: echo 0x10000 try %d half %u ns rx %02x %02x %02x %02x %02x %02x %02x %02x%s\n",
+			    tries, neo5se_spi_half, rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7],
+			    same ? " (confirmed)" : "");
+			neo5se_log_flush_now();
+			if (same) {
+				break;
+			}
+			delay(5000);
 		}
-		printf("NEO5SE TOUCH: echo 0x10000 rx %02x %02x %02x %02x %02x %02x %02x %02x%s\n",
-		    rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7],
-		    same ? " (confirmed)" : "");
-		neo5se_log_flush_now();
 	}
 
 	/*
@@ -843,6 +852,18 @@
 	neo5se_touch_pin("reset", NEO5SE_TOUCH_RESET_GPIO);
 	neo5se_touch_pin("irq", NEO5SE_TOUCH_IRQ_GPIO);
 	neo5se_touch_pin("avdd", NEO5SE_TOUCH_AVDD_GPIO);
+	/*
+	 * Drive the SPI pads before the part leaves reset. Android's QUP owns
+	 * them (clock low, CS high) at that moment; here they were still floating
+	 * inputs, and a part that samples its bus at reset release can latch the
+	 * wrong interface mode.
+	 */
+	if (neo5se_spi_pins() == 0) {
+		printf("NEO5SE TOUCH: spi pads driven before power-on\n");
+	} else {
+		printf("NEO5SE TOUCH: spi pads could not be mapped\n");
+	}
+	neo5se_log_flush_now();
 	neo5se_touch_power();
 	neo5se_touch_geni_probe();
 	neo5se_touch_spi_probe();
