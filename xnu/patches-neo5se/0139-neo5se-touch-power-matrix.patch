+/*
+ * The rail is on (the RPMh read-back says enable 1, 1800 mV) and MISO is
+ * floating (all zeros with a pull-down, all ones with a pull-up), so the part
+ * is not running. AVDD (GPIO71) and reset (GPIO20) are the two lines left;
+ * try every level combination, waiting long enough for the part to boot after
+ * each one, and read the echo. First idea wins and the log names it.
+ */
+static int
+neo5se_touch_power_matrix(void)
+{
+	static const int avdd_level[4] = { 1, 1, 0, 0 };
+	static const int reset_level[4] = { 1, 0, 1, 0 };
+	uint8_t tx[8], rx[8];
+	int i, j, bra, nonzero;
+
+	for (i = 0; i < 4; i++) {
+		neo5se_tlmm_output(neo5se_touch_avdd_page, 0,
+		    NEO5SE_TLMM_DRIVE_2MA, avdd_level[i]);
+		neo5se_tlmm_output(neo5se_touch_reset_page, 0,
+		    NEO5SE_TLMM_DRIVE_8MA, reset_level[i]);
+		delay(150000);
+
+		tx[0] = 0x01;
+		(void)neo5se_goodix_write(0xc900, tx, 1);
+		delay(2000);
+		for (j = 0; j < 8; j++) {
+			tx[j] = 0xaa;
+		}
+		(void)neo5se_goodix_write(0x10000, tx, 8);
+		delay(1000);
+		for (bra = 0; bra < 2; bra++) {
+			(void)neo5se_goodix_read_ex(0x10000, rx, 8, bra);
+			nonzero = 0;
+			for (j = 0; j < 8; j++) {
+				if (rx[j] != 0) {
+					nonzero = 1;
+				}
+			}
+			printf("NEO5SE TOUCH: matrix avdd %d reset %d irq %u %s echo %02x %02x %02x %02x %02x %02x %02x %02x%s\n",
+			    avdd_level[i], reset_level[i],
+			    neo5se_tlmm_read(neo5se_touch_irq_page, NEO5SE_TLMM_IN_OUT) & 1,
+			    bra ? "bra" : "std",
+			    rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7],
+			    nonzero ? " (answered)" : "");
+			neo5se_log_flush_now();
+			if (nonzero) {
+				return 0;
+			}
+		}
+	}
+	return -1;
 }
 
