diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1063,6 +1063,22 @@
 	va_end(panic_str_args);
 }
 #endif /* defined (__x86_64__) */
+
+#if defined(NEO5SE)
+/* The reason of the panic, kept so that it can be printed again at the end
+ * (see panic_trap_to_debugger): the console cannot be scrolled. */
+static char neo5se_panic_reason[256];
+static unsigned int neo5se_panic_len;
+
+static void
+neo5se_panic_putc(char c)
+{
+	if (neo5se_panic_len < sizeof(neo5se_panic_reason) - 1) {
+		neo5se_panic_reason[neo5se_panic_len++] = c;
+		neo5se_panic_reason[neo5se_panic_len] = '\0';
+	}
+}
+#endif
 
 #pragma clang diagnostic push
 #pragma clang diagnostic ignored "-Wmissing-noreturn"
@@ -1075,6 +1091,20 @@
 #if defined(NEO5SE)
 	/* No CPU/thread/debugger state is required for this first panic copy. */
 	neo5se_early_panic(panic_format_str, panic_args);
+	/*
+	 * The phone's console cannot be scrolled and a panic is longer than
+	 * the screen, so the first line - the reason - is gone by the time
+	 * the panic ends. Keep a copy and print it again at the end, so the
+	 * last thing on the screen is why the kernel died.
+	 */
+	{
+		va_list copy;
+
+		va_copy(copy, *panic_args);
+		neo5se_panic_len = 0;
+		_doprnt(panic_format_str, copy, neo5se_panic_putc, 16);
+		va_end(copy);
+	}
 #endif
 
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
@@ -1460,6 +1490,12 @@
 	}
 
 	paniclog_append_noflush("\nPlease go to https://panic.apple.com to report this panic\n");
+#if defined(NEO5SE)
+	/* The last line on the screen: why the kernel died. */
+	if (neo5se_panic_len != 0) {
+		printf("NEO5SE PANIC: %s\n", neo5se_panic_reason);
+	}
+#endif
 	panic_spin_forever();
 }
 
