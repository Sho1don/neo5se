 	uint32_t msgid = NEO5SE_CMD_MSGID_LEN | NEO5SE_CMD_MSGID_WRITE |
 	    NEO5SE_CMD_MSGID_RESP;
@@ -602,7 +632,7 @@ neo5se_rpmh_write_one(uint32_t addr, uint32_t data)
