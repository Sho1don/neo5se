-/*
- * One SPI transfer through the SE's own DMA engine. This SE has the FIFO
- * interface disabled (GENI_IF_DISABLE_RO = 1, measured on 0126); a FIFO
- * command stays active for ever, so the bytes have to come from a DMA
- * buffer. TX buffer at offset 0 of the page, RX at 64.
- */
+static int
+neo5se_spi_bit(int mosi)
+{
+	neo5se_tlmm_write(neo5se_spi_mosi, NEO5SE_TLMM_IN_OUT, mosi ? 2 : 0);
+	neo5se_spi_delay(400);
+	neo5se_tlmm_write(neo5se_spi_clk, NEO5SE_TLMM_IN_OUT, 2);
+	neo5se_spi_delay(400);
+	int miso = (int)(neo5se_tlmm_read(neo5se_spi_miso, NEO5SE_TLMM_IN_OUT) & 1);
+	neo5se_tlmm_write(neo5se_spi_clk, NEO5SE_TLMM_IN_OUT, 0);
+	neo5se_spi_delay(400);
+	return miso;
+}
