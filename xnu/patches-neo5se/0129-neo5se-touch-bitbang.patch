+/*
+ * Bit-banged SPI on the touch pads. The QUPv3 SE has its FIFO interface
+ * disabled by firmware (GENI_IF_DISABLE_RO = 1, 0126) and its SE DMA path
+ * wedges the interconnect (0129), so the first touch driver clocks the part
+ * from the TLMM: GPIO16 clk, 17 mosi, 18 miso, 19 cs, mode 0, MSB first.
+ * ~500 ns per half period (about 1 MHz) from the 19.2 MHz timebase.
+ */
+static vm_offset_t neo5se_spi_clk, neo5se_spi_mosi, neo5se_spi_miso,
+    neo5se_spi_cs;
+static uint64_t neo5se_spi_hz;
 
