xnu 0102: one detailed sampler dump with thread backtraces

The one-line sample proved SpringBoard exists (pid 27) but not what it waits
on. Once the process list has more than 20 entries, print every thread of each
wanted process with pc/lr/sp and a frame-pointer backtrace (the existing
neo5se_sample_task()), once per boot.

diff --git a/bsd/dev/neo5se_sample.c b/bsd/dev/neo5se_sample.c
index a38d1ec..e762c6c 100644
--- a/bsd/dev/neo5se_sample.c
+++ b/bsd/dev/neo5se_sample.c
@@ -160,7 +160,7 @@ neo5se_sample_proc(proc_t p, __unused void *arg)
 void
 neo5se_sample_tick(void)
 {
-	static bool armed;
+	static bool armed, dumped;
 
 	if (!armed) {
 		armed = true;
@@ -185,6 +185,17 @@ neo5se_sample_tick(void)
 		    neo5se_want_pid[k], neo5se_want_pc[k]);
 	}
 	printf("\n");
+
+	/*
+	 * Once the process list is populated, dump every thread of the wanted
+	 * processes with its pc/lr/sp and frame-pointer backtrace: the pc
+	 * alone says whether it waits in mach_msg, but not for what.
+	 */
+	if (!dumped && neo5se_proc_count > 20) {
+		dumped = true;
+		printf("SMP --- detailed sample, %d procs\n", neo5se_proc_count);
+		proc_iterate(PROC_ALLPROCLIST, neo5se_sample_proc, NULL, NULL, NULL);
+	}
 }
 
 static void
